---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from '../../components/Toc.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Figure from '../../components/Figure.astro';
import { CATEGORIES, formatDate } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, description, category, cover, pubDate, updatedDate, tags } = entry.data;
const meta = CATEGORIES[category];

const ordered = (await getCollection('blog', (post) => !post.data.draft)).sort(
  (a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf(),
);
const currentIndex = ordered.findIndex((post) => post.id === entry.id);
const prev = currentIndex > 0 ? ordered[currentIndex - 1] : null;
const next = currentIndex < ordered.length - 1 ? ordered[currentIndex + 1] : null;
---

<BaseLayout title={title} description={description}>
  <Breadcrumb items={[{ label: 'บล็อก', href: '/blog' }, { label: title }]} />

  <div class="prose">
    <article>
      <div class="post-meta">
        <a class="badge" href={`/category/${category}`} style={`--badge-color:${meta.color}`}>
          {meta.label}
        </a>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {
          updatedDate && (
            <span>(อัปเดตล่าสุด {formatDate(updatedDate)})</span>
          )
        }
      </div>
      <h1>{title}</h1>
      <p class="lead">{description}</p>

      <Figure
        src={cover ?? meta.cover}
        alt={title}
        loading="eager"
      />

      <Content />

      {
        tags.length > 0 && (
          <div class="post-meta" style="margin-top:2.5rem">
            {tags.map((tag) => (
              <a class="badge" href={`/tags/${tag}`}>#{tag}</a>
            ))}
          </div>
        )
      }
    </article>

    <section class="giscus-wrap" aria-label="ความคิดเห็น">
      <h2 class="giscus-heading">ความคิดเห็น</h2>
      <div id="giscus-comments"></div>
    </section>
  </div>

  <Toc headings={headings} />

  <nav class="post-nav" aria-label="ไปยังบทความก่อนหน้าและถัดไป">
    {
      prev ? (
        <a class="post-nav__item" href={`/blog/${prev.id}`}>
          <span class="post-nav__label">← บทความก่อนหน้า</span>
          <span class="post-nav__title">{prev.data.title}</span>
        </a>
      ) : (
        <span class="post-nav__item post-nav__item--empty" />
      )
    }
    {
      next ? (
        <a class="post-nav__item post-nav__item--right" href={`/blog/${next.id}`}>
          <span class="post-nav__label">บทความถัดไป →</span>
          <span class="post-nav__title">{next.data.title}</span>
        </a>
      ) : (
        <span class="post-nav__item post-nav__item--empty" />
      )
    }
  </nav>

  <script is:inline>
    (() => {
      const wrap = document.getElementById('giscus-comments');
      if (!wrap) return;

      const resolveTheme = () => {
        const root = document.documentElement;
        let t = root.dataset.theme;
        if (t === 'system' || !t) {
          t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        return t;
      };

      const loadGiscus = () => {
        wrap.innerHTML = '';
        const s = document.createElement('script');
        s.src = 'https://giscus.app/client.js';
        s.setAttribute('data-repo', 'worawitblog-collab/my-blog-01');
        s.setAttribute('data-repo-id', 'R_kgDOUXoGwg');
        s.setAttribute('data-category', 'Announcements');
        s.setAttribute('data-category-id', 'DIC_kwDOUXoGws4DFbN6');
        s.setAttribute('data-mapping', 'pathname');
        s.setAttribute('data-strict', '0');
        s.setAttribute('data-reactions-enabled', '1');
        s.setAttribute('data-emit-metadata', '0');
        s.setAttribute('data-input-position', 'bottom');
        s.setAttribute('data-theme', resolveTheme());
        s.setAttribute('data-lang', 'th');
        s.setAttribute('crossorigin', 'anonymous');
        s.async = true;
        wrap.appendChild(s);
      };

      loadGiscus();
      window.__giscusTheme = resolveTheme();

      const syncTheme = () => {
        const t = resolveTheme();
        if (t === window.__giscusTheme) return;
        window.__giscusTheme = t;
        const iframe = wrap.querySelector('iframe');
        if (iframe) {
          iframe.contentWindow.postMessage({ giscus: { setConfig: { theme: t } } }, 'https://giscus.app');
        } else {
          loadGiscus();
        }
      };

      new MutationObserver(syncTheme).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });

      if (window.matchMedia) {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', syncTheme);
      }
    })();
  </script>
</BaseLayout>
