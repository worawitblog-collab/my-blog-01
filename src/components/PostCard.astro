---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES, formatDate } from '../lib/site';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, category, pubDate, updatedDate, cover, tags, author } = post.data;
const meta = CATEGORIES[category];
const image = cover ?? meta.cover;
const displayDate = updatedDate ?? pubDate;
---

<div class="blog-entry">
  <div class="blog-entry__meta">
    <div class="blog-entry__date">
    <time datetime={displayDate.toISOString()}>{formatDate(displayDate)}</time>
    {updatedDate && <span class="updated-mark">updated</span>}
  </div>
    <div class="blog-entry__tags">
      <a class="tag-pill" href={`/category/${category}`}>{meta.label}</a>
      {tags.map((tag) => (
        <a class="tag-pill" href={`/tags/${tag}`}>#{tag}</a>
      ))}
    </div>
  </div>
  <a class="blog-entry__content" href={`/blog/${post.id}`}>
    <img class="blog-entry__img" src={image} alt={title} loading="lazy" />
    <div class="blog-entry__text">
      <h3>{title}</h3>
      <p class="blog-entry__author">by {author}</p>
      <p class="blog-entry__desc">{description}</p>
    </div>
  </a>
</div>
