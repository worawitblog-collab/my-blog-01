---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings?: MarkdownHeading[];
}

const { headings = [] } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && (
    <nav class="toc" aria-label="สารบัญ">
      <p class="toc-title">สารบัญ</p>
      <ul>
        {items.map((h) => (
          <li class={h.depth === 3 ? 'toc-h3' : 'toc-h2'}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  if (links.length > 0) {
    const heads = links
      .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter((el): el is HTMLElement => !!el);

    function update() {
      let current = heads[0]?.id ?? '';
      for (const h of heads) {
        if (h.getBoundingClientRect().top <= 130) current = h.id;
        else break;
      }
      for (const a of links) {
        a.classList.toggle('active', decodeURIComponent(a.hash.slice(1)) === current);
      }
    }

    let ticking = false;
    document.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(() => {
            update();
            ticking = false;
          });
        }
      },
      { passive: true },
    );
    update();
  }
</script>
