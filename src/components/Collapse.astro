---
interface Props {
  title: string;
  color?: string;
  count?: number;
  open?: boolean;
}

const { title, color = 'var(--accent)', count, open = false } = Astro.props;
---

<details class="collapse" open={open || undefined} style={`--c-color:${color}`}>
  <summary class="collapse__head">
    <span class="collapse__label">
      <span class="collapse__dot" aria-hidden="true"></span>
      <span>{title}</span>
      {count !== undefined && <span class="collapse__count">{count}</span>}
    </span>
    <svg
      class="collapse__chev"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </summary>
  <div class="collapse__body">
    <slot />
  </div>
</details>

<style>
  .collapse {
    margin: 1.4rem 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--c-color);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .collapse__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem 1.3rem;
    list-style: none;
    cursor: pointer;
    user-select: none;
    transition: background 0.15s ease;
  }

  .collapse__head::-webkit-details-marker {
    display: none;
  }

  .collapse__head:hover {
    background: color-mix(in srgb, var(--c-color) 6%, transparent);
  }

  .collapse__label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.08rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .collapse__dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--c-color);
    flex-shrink: 0;
  }

  .collapse__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.45rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--c-color);
    background: color-mix(in srgb, var(--c-color) 12%, transparent);
  }

  .collapse__chev {
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform 0.2s ease;
  }

  .collapse[open] .collapse__chev {
    transform: rotate(180deg);
  }

  .collapse__body {
    padding: 1rem 1.3rem 1.3rem;
    border-top: 1px dashed var(--border);
    animation: collapse-in 0.18s ease;
  }

  @keyframes collapse-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>