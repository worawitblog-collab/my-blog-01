---
import Icon from './Icon.astro';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol>
    <li>
      <a href="/"><Icon name="home" size={14} /> หน้าแรก</a>
    </li>
    {
      items.map((item) => (
        <li>
          <a href={item.href} aria-current={item.href ? undefined : 'page'}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ol>
</nav>
